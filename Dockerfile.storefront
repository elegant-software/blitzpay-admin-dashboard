FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ARG BUILD_CONFIGURATION=production
RUN npm run build:storefront -- --configuration $BUILD_CONFIGURATION

FROM nginx:1.27-alpine

# The nginx image renders templates/*.template into conf.d with envsubst at start; API_HOST
# comes from the blitzpay-domains ConfigMap.
COPY nginx/storefront.conf /etc/nginx/templates/default.conf.template

COPY --from=build /app/dist/blitz-pay-web/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
