{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "blitzpay-admin-dashboard": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/blitzpay-admin-dashboard",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@coreui/coreui/dist/css/coreui.min.css",
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.aws-staging.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                }
              ],
              "outputHashing": "all"
            },
            "aws-staging": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.aws-staging.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                }
              ],
              "outputHashing": "all",
              "sourceMap": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "blitzpay-admin-dashboard:build:production"
            },
            "development": {
              "buildTarget": "blitzpay-admin-dashboard:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@coreui/coreui/dist/css/coreui.min.css",
              "src/styles.css"
            ],
            "scripts": [],
            "include": [
              "src/app/**/*.spec.ts"
            ]
          }
        },
        "contract-test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.contract.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@coreui/coreui/dist/css/coreui.min.css",
              "src/styles.css"
            ],
            "scripts": [],
            "include": [
              "src/contract-tests/**/*.contract.spec.ts"
            ]
          }
        }
      }
    },
    "blitz-pay-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": true
        }
      },
      "root": "projects/blitz-pay-web",
      "sourceRoot": "projects/blitz-pay-web/src",
      "prefix": "web",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/blitz-pay-web",
            "index": "projects/blitz-pay-web/src/index.html",
            "browser": "projects/blitz-pay-web/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/blitz-pay-web/tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [],
            "styles": [
              "projects/blitz-pay-web/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/blitz-pay-web/src/environments/environment.ts",
                  "with": "projects/blitz-pay-web/src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "projects/blitz-pay-web/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "blitz-pay-web:build:production"
            },
            "development": {
              "buildTarget": "blitz-pay-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/blitz-pay-web/tsconfig.spec.json",
            "inlineStyleLanguage": "css",
            "assets": [],
            "styles": [
              "projects/blitz-pay-web/src/styles.css"
            ],
            "scripts": [],
            "include": [
              "projects/blitz-pay-web/src/app/**/*.spec.ts"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
